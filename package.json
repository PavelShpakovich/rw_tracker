{
  "name": "rw-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"pnpm --filter @rw/web dev\" \"pnpm --filter @rw/worker dev\"",
    "start": "concurrently -k -n web,worker -c blue,magenta \"pnpm --filter @rw/web start\" \"pnpm --filter @rw/worker start\"",
    "build": "pnpm --filter @rw/web build",
    "worker": "pnpm --filter @rw/worker start",
    "worker:once": "pnpm --filter @rw/worker start --once",
    "stop": "pkill -f 'rw-tracker.*src/index.ts'; true",
    "check-route": "pnpm --filter @rw/worker check-route",
    "db:generate": "pnpm --filter @rw/db generate",
    "db:migrate": "pnpm --filter @rw/db migrate",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "packageManager": "pnpm@10.33.2"
}
