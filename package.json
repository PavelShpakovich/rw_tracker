{
  "name": "rw-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"next dev\" \"tsx watch --env-file-if-exists=.env src/worker/index.ts\"",
    "start": "concurrently -k -n web,worker -c blue,magenta \"next start\" \"tsx --env-file-if-exists=.env src/worker/index.ts\"",
    "build": "next build",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "worker:once": "tsx --env-file-if-exists=.env src/worker/index.ts --once",
    "check-route": "tsx --env-file-if-exists=.env scripts/check-route.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.33.2"
}
