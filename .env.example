# Bot token. Use the token of the bot that sends you notifications (it is used for sendMessage only).
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (get it from @userinfobot). Notifications go to this private chat.
# Open the bot in Telegram once and press Start, otherwise Telegram will not let it write to you.
TELEGRAM_ALLOWED_USER_ID=
# Password for the web UI (leave empty to disable)
APP_PASSWORD=
# Default polling interval for new trackers, seconds (min 60)
DEFAULT_INTERVAL_SEC=120
# SQLite file location, relative to the project root
DATABASE_PATH=data/app.db
