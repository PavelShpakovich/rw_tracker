# Bot token. Use the token of the bot that sends you notifications (it is used for sendMessage only).
TELEGRAM_BOT_TOKEN=
# Password for the web UI (required on Vercel, optional locally)
APP_PASSWORD=
# Default polling interval for new trackers, seconds (min 60)
DEFAULT_INTERVAL_SEC=120
# Database URL:
#   pglite:./data/pg        — local PGlite file (default, no Postgres needed)
#   pglite:memory           — in-memory PGlite (tests)
#   postgresql://...        — Supabase or any Postgres instance
DATABASE_URL=pglite:./data/pg
